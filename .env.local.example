# Copy this file to .env.local for local development,
# and add the same two variables in Vercel → Project Settings → Environment Variables.
# Only use the Supabase "anon" / "public" key here — never the service_role key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Telegram order/low-stock notifications.
# IMPORTANT: do NOT prefix these with NEXT_PUBLIC_ — they must stay
# server-only. Only app/api/notify-telegram/route.js reads them.
# Get the bot token from @BotFather, and the chat ID from your channel
# (e.g. by adding @get_id_bot to it, or via the getUpdates API).
TELEGRAM_BOT_TOKEN=123456789:YOUR-BOT-TOKEN
TELEGRAM_CHAT_ID=-1001234567890
